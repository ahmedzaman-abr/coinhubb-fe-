---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Coin from '../../components/Coin.astro';
import Footer from '../../components/Footer.astro';
import Drop from '../../components/Drop.astro';
import Art from '../../components/Art.astro';
import { stories, readMins, url, fmtDate, SECTIONS, type Story } from '../../lib/content';

export async function getStaticPaths() {
  const all = await stories();
  return all.map(s => ({ params: { slug: s.id }, props: { story: s, all } }));
}
const { story, all } = Astro.props as { story: Story; all: Story[] };
const d = story.data;
const { Content } = await render(story);
const guide = d.guide ? await getEntry('guides', d.guide) : undefined;
const next = [...all.filter(s => s !== story && s.data.section === d.section), ...all.filter(s => s !== story && s.data.section !== d.section)].slice(0, 3);
const initials = d.author.split(/\s+/).map(w => w[0]).join('').slice(0, 2).toUpperCase();
const share = encodeURIComponent(new URL(url(story), Astro.site).toString());
---
<Base title={d.title} description={d.dek} image={d.image} type="article">
  <header class="atop">
    <div class="wrap">
      <a class="round" href="/" aria-label="Back to homepage"><svg viewBox="0 0 24 24"><path d="M19 12H6M11 6l-6 6 6 6"/></svg></a>
      <a class="logo" href="/"><Coin />COINMOBB</a>
      <button class="round lime" type="button" aria-label="Share this story" data-copy><svg viewBox="0 0 24 24"><path d="M12 15V4M7 9l5-5 5 5M5 14v6h14v-6"/></svg></button>
    </div>
  </header>
  <div class="xp" aria-hidden="true"><div class="wrap"><span data-xp>XP 000</span><div class="bar">{Array.from({ length: 16 }, () => <i></i>)}</div></div></div>

  <main class="wrap">
    <article class="story">
      <div class="ahead">
        <a class="label" href={`/s/${d.section}/`}>{SECTIONS[d.section]}</a>
        <h1>{d.title}</h1>
        <p class="dek">{d.dek}</p>
        <div class="auth"><span class="av">{initials}</span><div><b>{d.author}</b><time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time> · {readMins(story)} min read</div></div>
      </div>
      <figure class="aimg" style="margin-inline:0">
        <Art src={d.image} alt={d.imageCaption} seed={story.id} eager />
        {d.imageCaption && <figcaption>{d.imageCaption}</figcaption>}
      </figure>
      <div class="prose"><Content /></div>

      {guide && !guide.data.draft && (
        <aside class="plug">
          <span class="k">Level up · Mobb Guide</span>
          <h2 class="t">{guide.data.title}</h2>
          <p>{guide.data.blurb} {guide.data.price}.</p>
          <a class="buy" href={guide.data.buyUrl}>Get the guide</a>
        </aside>
      )}

      <div class="share">
        <span>Share</span>
        <a href={`https://wa.me/?text=${share}`}>WhatsApp</a>
        <a href={`https://x.com/intent/post?url=${share}`}>X</a>
        <button type="button" data-copy>Copy link</button>
      </div>
      {d.tags.length > 0 && <div class="tags">{d.tags.map(t => <span>#{t.toUpperCase()}</span>)}</div>}
      <p class="disclaim" data-story-end>Not financial advice. We explain things; you make your own calls.</p>

      {next.length > 0 && (
        <nav class="next" aria-label="Read next">
          <h2>READ NEXT</h2>
          {next.map(n => <a href={url(n)}><span class="k">{SECTIONS[n.data.section]}</span><span class="t">{n.data.title}</span></a>)}
        </nav>
      )}
    </article>
  </main>
  <Drop heading="Liked this? Get THE DROP." />
  <Footer />
  <script>
    import { wireXP, wireShare } from '../../lib/retro';
    wireXP();
    wireShare();
  </script>
</Base>
